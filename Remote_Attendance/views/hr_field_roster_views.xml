<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_field_roster_import_view_form" model="ir.ui.view">
        <field name="name">hr.field.roster.import.form</field>
        <field name="model">hr.field.roster.import</field>
        <field name="arch" type="xml">
            <form string="Cargar lista de WhatsApp">
                <field name="state" invisible="1"/>
                <group invisible="state != 'draft'">
                    <field name="date"/>
                    <field name="message" nolabel="1" colspan="2"
                           placeholder="Pega aquí el mensaje del supervisor, por ejemplo:&#10;PRESUPUESTO: 2316-26 _ES&#10;ACTIVIDAD: ...&#10;PERSONAL:&#10;Juan Pérez&#10;Pedro López 1/2 día"/>
                </group>
                <group invisible="state != 'preview'">
                    <group>
                        <field name="supervisor_id" options="{'no_create': True}"/>
                        <field name="date"/>
                    </group>
                    <group>
                        <field name="unassigned_block_count" string="Obras sin proyecto" invisible="not unassigned_block_count"/>
                        <field name="unmatched_count" string="Nombres sin identificar" invisible="not unmatched_count"/>
                    </group>
                </group>
                <field name="block_ids" invisible="state != 'preview'">
                    <list editable="bottom" create="false" delete="false"
                          decoration-danger="not project_id">
                        <field name="title"/>
                        <field name="project_id" options="{'no_create': True}"/>
                        <field name="match" widget="badge"
                               decoration-success="match in ('exact', 'alias')"
                               decoration-danger="match == 'none'"/>
                        <field name="people_count"/>
                        <field name="suggested_project_id" column_invisible="1"/>
                    </list>
                </field>
                <field name="line_ids" invisible="state != 'preview'">
                    <list editable="bottom" create="false" delete="false"
                          decoration-danger="include and not employee_id"
                          decoration-warning="include and (match == 'fuzzy' or warning)"
                          decoration-muted="not include">
                        <field name="include" widget="boolean_toggle"/>
                        <field name="block_id"/>
                        <field name="raw_name"/>
                        <field name="employee_id" options="{'no_create': True}"/>
                        <field name="fraction"/>
                        <field name="hours" widget="float_time" optional="hide"/>
                        <field name="match" widget="badge"
                               decoration-success="match in ('key', 'exact', 'alias')"
                               decoration-warning="match == 'fuzzy'"
                               decoration-danger="match == 'none'"/>
                        <field name="warning"/>
                        <field name="suggested_employee_id" column_invisible="1"/>
                    </list>
                </field>
                <footer>
                    <button name="action_read_message" type="object" string="Leer mensaje" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_confirm" type="object" string="Registrar asistencia" class="btn-primary"
                            invisible="state != 'preview'"/>
                    <button name="action_back" type="object" string="Volver" invisible="state != 'preview'"/>
                    <button special="cancel" string="Cancelar"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="hr_field_roster_import_action" model="ir.actions.act_window">
        <field name="name">Cargar lista de WhatsApp</field>
        <field name="res_model">hr.field.roster.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="hr_field_alias_view_list" model="ir.ui.view">
        <field name="name">hr.field.alias.list</field>
        <field name="model">hr.field.alias</field>
        <field name="arch" type="xml">
            <list string="Nombres recordados" editable="bottom">
                <field name="name"/>
                <field name="employee_id"/>
            </list>
        </field>
    </record>

    <record id="hr_field_project_alias_view_list" model="ir.ui.view">
        <field name="name">hr.field.project.alias.list</field>
        <field name="model">hr.field.project.alias</field>
        <field name="arch" type="xml">
            <list string="Obras recordadas" editable="bottom">
                <field name="name"/>
                <field name="project_id"/>
            </list>
        </field>
    </record>

    <record id="hr_field_project_alias_action" model="ir.actions.act_window">
        <field name="name">Obras y actividades recordadas</field>
        <field name="res_model">hr.field.project.alias</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aún no hay obras recordadas</p>
            <p>Cuando eliges el proyecto de un presupuesto o de una actividad como "taller" al cargar una lista, Odoo lo recuerda aquí.</p>
        </field>
    </record>

    <record id="hr_field_alias_action" model="ir.actions.act_window">
        <field name="name">Nombres recordados</field>
        <field name="res_model">hr.field.alias</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aún no hay nombres recordados</p>
            <p>Cuando corriges un nombre al cargar una lista de WhatsApp, Odoo lo recuerda aquí para la próxima vez.</p>
        </field>
    </record>
</odoo>
