<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_field_attendance" model="ir.module.category">
        <field name="name">Asistencias en campo</field>
        <field name="sequence">15</field>
        <field name="parent_id" ref="base.module_category_human_resources"/>
    </record>

    <record id="group_field_operations" model="res.groups">
        <field name="name">Operaciones de campo</field>
        <field name="category_id" ref="module_category_field_attendance"/>
        <field name="comment">Asigna supervisores y obras, aprueba teléfonos, registra rostros y revisa marcajes en campo.</field>
        <field name="implied_ids" eval="[(4, ref('hr.group_hr_user')), (4, ref('hr_attendance.group_hr_attendance_officer'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
