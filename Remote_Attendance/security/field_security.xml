<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_field_attendance" model="ir.module.category">
        <field name="name">Asistencias en campo</field>
        <field name="sequence">15</field>
        <field name="parent_id" ref="base.module_category_human_resources"/>
    </record>

    <record id="group_field_operations" model="res.groups">
        <field name="name">Administrador de asistencias</field>
        <field name="category_id" ref="module_category_field_attendance"/>
        <field name="comment">Las únicas personas que ven y exportan los marcajes y el reporte de asistencia, aprueban teléfonos y checadores, registran rostros y cambian los ajustes del módulo.</field>
        <field name="implied_ids" eval="[(4, ref('hr.group_hr_user')), (4, ref('hr_attendance.group_hr_attendance_officer'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Attendance officers only see the employees they manage; the attendance administrators see everybody. -->
    <record id="rule_attendance_field_operations" model="ir.rule">
        <field name="name">Administrador de asistencias: todas las asistencias</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('Remote_Attendance.group_field_operations'))]"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
