<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="verify_page" name="Verificación de gafete">
        <html lang="es">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <meta name="robots" content="noindex, nofollow"/>
                <title>Verificación de gafete</title>
                <style>
                    body{margin:0;font-family:Arial,Helvetica,sans-serif;background:#f2f0ed;color:#000}
                    .wrap{max-width:420px;margin:0 auto;padding:24px 16px}
                    .card{background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 4px 16px rgba(0,0,0,.12)}
                    .head{padding:18px;text-align:center;font-weight:bold;letter-spacing:1px;border-bottom:4px solid #C8102E}
                    .status{padding:22px;text-align:center;color:#fff;font-size:30px;font-weight:bold;letter-spacing:2px}
                    .ok{background:#1b7f3a}.bad{background:#C8102E}.unk{background:#555}
                    .body{padding:22px;text-align:center}
                    .photo{width:150px;height:180px;object-fit:cover;border-radius:12px;border:5px solid #000;margin-bottom:14px}
                    .name{font-size:22px;font-weight:bold;text-transform:uppercase}
                    .job{font-size:18px;color:#C8102E;font-weight:bold;margin-top:6px}
                    .dep{font-size:16px;margin-top:4px}
                    .foot{font-size:13px;color:#444;text-align:center;padding:14px}
                </style>
            </head>
            <body>
                <div class="wrap">
                    <div class="card">
                        <div class="head">CONSTRUCTORA ETRES · VERIFICACIÓN DE GAFETE</div>
                        <t t-if="not found">
                            <div class="status unk">GAFETE NO VÁLIDO</div>
                            <div class="body">Este código no corresponde a ningún empleado registrado.</div>
                        </t>
                        <t t-elif="active">
                            <div class="status ok">✔ VIGENTE</div>
                        </t>
                        <t t-else="">
                            <div class="status bad">✖ NO VIGENTE</div>
                        </t>
                        <div class="body" t-if="found">
                            <img t-if="photo" class="photo" t-att-src="photo" alt="Foto del empleado"/>
                            <div class="name" t-out="name"/>
                            <div class="job" t-out="job"/>
                            <div class="dep" t-out="department"/>
                            <div class="dep" t-if="not active" style="margin-top:14px;font-weight:bold">
                                Esta persona ya no labora en la empresa. Favor de retener el gafete.
                            </div>
                        </div>
                    </div>
                    <div class="foot">
                        <t t-out="company"/> · Consultado el <t t-out="checked_at"/><br/>
                        Dudas: Oficinas 899 929 0910 · EHS 899 318 2391
                    </div>
                </div>
            </body>
        </html>
    </template>
</odoo>
