<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_badge_verify" model="ir.ui.view">
        <field name="name">hr.employee.form.badge.verify</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Gafete QR" name="badge_qr" groups="hr.group_hr_user">
                    <group>
                        <group>
                            <field name="badge_qr" widget="image" filename="badge_qr_filename"
                                   options="{'size': [180, 180]}" readonly="1"/>
                            <field name="badge_qr_filename" invisible="1"/>
                        </group>
                        <group>
                            <field name="badge_verify_url" widget="url" readonly="1"/>
                            <field name="badge_token" readonly="1"/>
                            <button name="action_regenerate_badge_token" type="object"
                                    string="Regenerar QR (invalida el gafete anterior)"
                                    class="btn-secondary"
                                    confirm="El gafete impreso actualmente dejará de ser válido. ¿Continuar?"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
