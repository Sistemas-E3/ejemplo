<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_download_badge_qr_zip" model="ir.actions.server">
        <field name="name">Descargar QR de gafetes</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="binding_view_types">list,form</field>
        <field name="groups_id" eval="[(4, ref('hr.group_hr_user'))]"/>
        <field name="state">code</field>
        <field name="code">
action = {
    "type": "ir.actions.act_url",
    "url": "/gafete/qr_zip?ids=%s" % ",".join(str(i) for i in records.ids),
    "target": "self",
}
        </field>
    </record>
</odoo>
